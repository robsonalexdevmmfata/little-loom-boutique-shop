# Mercado Pago (Checkout transparente / Payment Brick)
# Public key pode ir no cliente. Access token NUNCA no browser.
VITE_MP_PUBLIC_KEY=APP_USR-xxxxxxxx
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx

# Meta Ads (Pixel) — opcional; também dá para colar o ID no Admin → Integrações
VITE_META_PIXEL_ID=

# Melhor Envio
# Client ID/Secret são da aplicação OAuth. O token de acesso vem após autorizar o app.
MELHOR_ENVIO_CLIENT_ID=
MELHOR_ENVIO_CLIENT_SECRET=
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_FROM_CEP=01310100
MELHOR_ENVIO_SANDBOX=false
